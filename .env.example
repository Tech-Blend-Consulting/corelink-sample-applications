# Your CoreLink URL.
PLATFORM_URL=https://your-corelink.example.com

# Both identities: Identity > NHI > New, with the credential's workspace
# selected. Identity type: Service Account. External ID: leave empty.
# Owner: yourself. Copy the ID from the identity's page.

# The connector's identity. Grant: secrets / cache on the credential's name.
CONNECTOR_NHI_ID=

# The application's identity. Grant: secrets / unwrap on the credential's name.
APP_NHI_ID=

# The dynamic credential's secret name, as issued (for example orders-app-db).
SECRET_NAME=

# Optional. The connector image version; match your CoreLink stable release.
# CORELINK_VERSION=1.28.89

# Optional. Overrides the sslmode CoreLink issued (disable, prefer, require,
# verify-full).
# DB_SSLMODE=

# Optional. The local port for the app's page.
# APP_PORT=5051
